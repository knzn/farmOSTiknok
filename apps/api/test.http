@refresh = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2OWI5NzI1Zjg1ODdkMTZlMDdlZGFmOGYiLCJlbWFpbCI6InRlc3RicmVlZGVyQGV4YW1wbGUuY29tIiwidXNlcm5hbWUiOiJ0ZXN0YnJlZWRlciIsInR5cGUiOiJyZWZyZXNoIiwiaWF0IjoxNzczNzYxMzY0LCJleHAiOjE3NzYzNTMzNjR9.kH2FCk92FRPwrgC2HL-faBVxxBWCk6gibUIZVpJxHYc

@seasonId  = 69b97456b1667c3d3489eaf4
@matingId1 = 69b974d5b1667c3d3489eafc
@matingId2 = 69b974dfb1667c3d3489eb04
@matingId3 = 69b974e2b1667c3d3489eb0a
