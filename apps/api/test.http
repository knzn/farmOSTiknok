# Tiknok API — Manual test script
# Use VS Code REST Client extension (humao.rest-client) to run these
# Run them TOP TO BOTTOM in order — later requests depend on earlier ones
#
# After REGISTER: copy the accessToken and refreshToken values into the @access and @refresh variables below
# After CREATE SEASON: copy the _id into @seasonId
# After CREATE MATING: copy the _id into @matingId1 / @matingId2 etc.

@base = http://localhost:3001

# ──────────────────────────────────────────────────────────────────────────────
# Paste your tokens here after running REGISTER or LOGIN
# ──────────────────────────────────────────────────────────────────────────────
